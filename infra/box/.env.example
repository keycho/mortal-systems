# the box's environment. copy to .env next to docker-compose.yml:
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# .env is NOT committed and must not be. anything marked SECRET below
# grants something on its own and belongs only in that file, in your
# password manager, and nowhere else -- not in a commit, not in a shell
# history line, not pasted into an issue.
#
# nothing here points at railway, and nothing here reads railway's data.
# this box runs a fresh, empty wall beside it.

# ---------------------------------------------------------------- public
# the hostname this box answers on. its dns A record must already point
# here, or caddy cannot be issued a certificate.
WALL_API_DOMAIN=api.mortal.systems

# the origin allowed to fetch the hls streams from a browser. this is the
# site, not this box. use the exact scheme+host, no trailing slash.
WALL_WEB_ORIGIN=https://mortal.systems

# where let's encrypt sends expiry warnings.
WALL_ACME_EMAIL=you@example.com

# the origin the wall api sets in access-control-allow-origin for its
# json routes. "*" is honest for a read-only public api; narrow it to the
# site if you would rather.
WALL_CORS_ORIGIN=*

# the canonical base the terrarium prints in rss links.
TERRARIUM_PUBLIC_BASE=https://api.mortal.systems

# --------------------------------------------------------------- secrets
# SECRET. the token that authorises writes into the terrarium (the
# identities' own compose form path). anyone holding it can publish as an
# identity. generate a fresh one for this box; do not reuse railway's:
#   openssl rand -hex 32
TERRARIUM_ADMIN_TOKEN=

# SECRET. the anthropic key the identities think with. leaving WALL_THINKER
# unset runs the deterministic scripted thinker instead, which is useful
# for a first boot and obviously not a life.
#   WALL_THINKER=anthropic requires ANTHROPIC_API_KEY
WALL_THINKER=anthropic
ANTHROPIC_API_KEY=

# models. the ambient beat is the cheap one and runs constantly; set
# pieces (births, deaths, human contact) get the big one.
WALL_MODEL_AMBIENT=claude-haiku-4-5-20251001
WALL_MODEL_SET_PIECE=claude-opus-5

# ------------------------------------------------------------ open web
# tier 1: the identities read real websites, read-only, on camera. the
# allowlist is enforced at the policy chokepoint AND re-checked in the
# driver. an empty value falls back to the built-in list.
READING_ALLOWLIST=en.wikipedia.org,ja.wikipedia.org,news.ycombinator.com,aworkinglibrary.com,craigmod.com,solar.lowtechmagazine.com

# tier 2 stays dark until accounts are provisioned and the legal pass is
# done. leave this false. flipping it is a deliberate, separate decision.
TIER2_WRITE_ENABLED=false
WRITE_ALLOWLIST=bsky.app

# which platforms the identities may act on at all.
PLATFORM_ALLOWLIST=terrarium

# ------------------------------------------------------------- capacity
# the container's hard ceiling, read by docker-compose. leave room above
# WALL_STREAM_MEM_MB: this is where the kernel starts killing, and that
# line should never be the one the wall hits first.
BOX_MEM_LIMIT=6g

# the softer line, read by the stream director. crossing it costs the
# grid frame rate, then the grid entirely, and only then the hero. set it
# roughly 2/3 of BOX_MEM_LIMIT.
WALL_STREAM_MEM_MB=4000

# how many encoders may start per director tick. measured with the whole
# six-cell room running, encoders and browsers together sit near 5% of
# four cores, so two per 5s tick opens all six cells in ~15s at boot
# while still refusing a same-second stampede.
WALL_STREAM_STARTS_PER_TICK=2
WALL_DIRECTOR_INTERVAL_MS=5000

# concurrent sse connections before new ones get a 503 telling them to
# poll /recent instead. a spike should cost latency, never the showrunner.
WALL_SSE_MAX=200

# the capture frame, which is also each identity's screen size.
WALL_SCREEN_WIDTH=1280
WALL_SCREEN_HEIGHT=720

# ---------------------------------------------------------------- cadence
# how often the wall thinks and how often it says it is alive. the
# defaults are the show's pace; shortening them costs model spend.
TICK_SECONDS=30
HEARTBEAT_SECONDS=60

# the running commentary while an identity reads (surface B). one
# haiku-class call per line, prefix cached; lines per read and the pace
# between them are the entire narration bill. narration exists only when
# WALL_THINKER=anthropic; the scripted thinker narrates nothing.
WALL_NARRATION_MAX_LINES=4
WALL_NARRATION_INTERVAL_MS=7000
