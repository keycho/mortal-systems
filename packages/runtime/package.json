{
  "name": "@liminal/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "the liminal runtime: the local service that owns identities, manifests, lifecycle, deletion, and activity logs. every client speaks its typed api.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "liminal-runtime": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts serve --root \"${LIMINAL_ROOT:-$HOME/.liminal}\" --port 4923 --admin-token \"${LIMINAL_ADMIN_TOKEN:-liminal-dev}\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@liminal/blueprints": "workspace:*",
    "@liminal/schema": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
