{
  "name": "@mortal/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "the mortal runtime: the local service that owns identities, manifests, lifecycle, deletion, and activity logs. every client speaks its typed api.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mortal-runtime": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --conditions=development src/cli.ts serve --root \"${MORTAL_ROOT:-$HOME/.mortal}\" --port 4923 --admin-token \"${MORTAL_ADMIN_TOKEN:-mortal-dev}\" --seed-first-party",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mortal/blueprints": "workspace:*",
    "@mortal/schema": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
