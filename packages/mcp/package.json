{
  "name": "@mortal/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "the mortal mcp server + agent sdk: identity primitives for mcp agents — create, launch, status, destroy, blueprints, capabilities. a thin wrapper over the runtime's typed api; an agent can only ever attach to identities mortal launched.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mortal-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mortal/schema": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
