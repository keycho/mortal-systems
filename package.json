{
  "name": "mortal-systems",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@mortal/runtime --filter=manager",
    "dev:web": "turbo run dev --filter=web",
    "dev:manager": "turbo run dev --filter=manager",
    "dev:runtime": "turbo run dev --filter=@mortal/runtime",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:manager": "turbo run tauri:build --filter=manager",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "pnpm --filter mortal-tests test:isolation",
    "test:lifecycle": "pnpm --filter mortal-tests test:lifecycle",
    "check": "pnpm lint && turbo run typecheck && pnpm check:guarantees && pnpm check:cli && pnpm check:mortal-cli && pnpm check:mcp && pnpm check:brand",
    "check:guarantees": "tsx scripts/check-guarantees.ts",
    "check:cli": "turbo run build --filter=@mortal/runtime && node scripts/smoke-cli.mjs",
    "check:mortal-cli": "turbo run build --filter=@mortal/runtime --filter=@mortal/cli && node scripts/smoke-mortal-cli.mjs",
    "check:brand": "turbo run build --filter=web && node scripts/check-brand.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:agent": "node scripts/demo-agent.mjs",
    "check:mcp": "node scripts/smoke-mcp.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@mortal/cli": "workspace:*",
    "eslint": "^9.30.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.35.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "packageExtensions": {
      "next": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  }
}
